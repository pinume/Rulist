{
  "name": "rulist-web",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Web frontend for Rulist",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite --force",
    "build": "vite build --mode production",
    "serve": "vite preview",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --ignore-path .gitignore -w \"src/**/*.{js,ts,json,css,tsx,jsx}\""
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/streamsaver": "^2.0.5",
    "prettier": "3.8.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vite-plugin-dynamic-base": "^1.3.0",
    "vite-plugin-solid": "^2.11.12"
  },
  "dependencies": {
    "@stitches/core": "1.2.8",
    "@hope-ui/solid": "github:OpenListTeam/hope-ui#31b436e36ae5d266016814ba71a442ffa9d91181",
    "@solid-primitives/i18n": "^2.2.1",
    "@solid-primitives/storage": "^1.3.11",
    "@solidjs/router": "^0.9.1",
    "axios": "^1.18.1",
    "solid-icons": "1.1.0",
    "solid-js": "^1.9.14",
    "streamsaver": "^2.0.6"
  }
}
